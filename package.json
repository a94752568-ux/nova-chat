{
  "name": "nova-chat",
  "productName": "Nova Chat",
  "version": "1.0.0",
  "description": "Asistente de IA local para escritorio con UI Inteligente, corrección gramatical tipo Grammarly y autocompletado por IA",
  "main": "src/main/electron.main.js",
  "author": "Nova Project",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron --env=development .",
    "build": "electron-builder",
    "lint": "eslint src/",
    "test": "jest"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "ollama": "^0.5.0"
  },
  "devDependencies": {
    "electron-builder": "^24.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.0.0"
  },
  "build": {
    "appId": "com.nova.chat",
    "productName": "Nova Chat",
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "src/renderer/assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "src/renderer/assets/icon.png",
      "category": "Office"
    }
  }
}
